# Settings for this server. Copy this file to .env and edit that copy.
#
#   cp .env.sample .env
#
# Started in a terminal for the first time with no .env, Fotobogen asks for
# the port, the site's address, and demo mode, and writes a short .env with
# the answers. `pnpm fotobogen init` asks again and keeps everything else.
#
# .env is read by Fotobogen when it starts and by docker compose. It is
# never committed (it is in .gitignore); this sample is. Anything set here
# overrides the defaults in fotobogen.config.js, and everything is optional.

# The port Fotobogen listens on when run without Docker. Left unset, it uses
# 5150, or the next free port above that.
# PORT=5150

# Where the site keeps its data when run without Docker.
# DATA_DIR=./data


# The domain name that points at this server. Caddy gets a certificate for it.
# Leave it commented out to try Fotobogen on http://localhost.
# DOMAIN=photos.example.com

# The user and group that should own the files in ./data.
# Run `id -u` and `id -g` to see yours; 1000 is the usual first user on Linux.
# PUID=1000
# PGID=1000

# With docker-compose.forge.yml, PORT (above) is the port on this machine
# that nginx forwards to.

# Upload limits: the largest file, in megabytes, and the largest image, in
# megapixels. If you raise MAX_UPLOAD_MB, also raise the proxy's limit
# (max_size in deploy/Caddyfile, client_max_body_size in nginx).
# MAX_UPLOAD_MB=50
# MAX_MEGAPIXELS=100

# Let webhooks call this machine or a private network (an automation tool
# on the same server, say). Off by default: webhooks may only call public
# addresses.
# WEBHOOKS_ALLOW_PRIVATE=1

# The site's proper address. Used wherever a full address is written out:
# a photo's links in the admin, the feed, the sitemap, and what search
# engines are told. Without it, links made on your own machine begin with
# http://localhost:5150. It can also be set in the admin, under Search and
# sharing; a value here wins over that one.
# SITE_URL=https://photos.example.com

# Demo mode, for a site meant to show Fotobogen off. Anyone can then log in
# with the username "demo" and the password "demo" and look round the whole
# admin, but cannot change anything, download a backup, or see API tokens
# or webhooks. Your own login keeps full control. A demo visitor does see
# hidden and scheduled photos. Leave it off on a site that is not a demo.
# DEMO_MODE=1

# The address to listen on. Left unset: every address the machine has.
# Behind nginx on the same machine, 127.0.0.1 keeps the app private to it.
# (ecosystem.config.cjs sets this itself under pm2.)
# HOST=127.0.0.1

# Set to 1 only when the app can be reached solely through your own reverse
# proxy. The visitor's address and "https" are then taken from the proxy's
# headers. (The pm2 and Docker files set this themselves.)
# TRUST_PROXY=1

# Start even when the check of the machine fails. At your own risk.
# FOTOBOGEN_SKIP_PREFLIGHT=1

# Two more are given when starting, not here, because they are read before
# this file is: FOTOBOGEN_NO_QUESTIONS=1 (ask nothing at the first start)
# and NO_COLOR=1 (plain text). For example:
#   NO_COLOR=1 pnpm start
