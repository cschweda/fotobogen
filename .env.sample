# Settings for this server. Copy this file to .env and edit that copy.
#
#   cp .env.sample .env
#
# .env is read by Fotobogen when it starts and by docker compose. It is
# never committed (it is in .gitignore); this sample is. Anything set here
# overrides the defaults in fotobogen.config.js, and everything is optional.

# The port Fotobogen listens on when run without Docker. Left unset, it uses
# 5150, or the next free port above that.
# PORT=5150

# Where the site keeps its data when run without Docker.
# DATA_DIR=./data


# The domain name that points at this server. Caddy gets a certificate for it.
# Leave it commented out to try Fotobogen on http://localhost.
# DOMAIN=photos.example.com

# The user and group that should own the files in ./data.
# Run `id -u` and `id -g` to see yours; 1000 is the usual first user on Linux.
# PUID=1000
# PGID=1000

# With docker-compose.forge.yml, PORT (above) is the port on this machine
# that nginx forwards to.

# Upload limits: the largest file, in megabytes, and the largest image, in
# megapixels. If you raise MAX_UPLOAD_MB, also raise the proxy's limit
# (max_size in deploy/Caddyfile, client_max_body_size in nginx).
# MAX_UPLOAD_MB=50
# MAX_MEGAPIXELS=100
