{
  "name": "papier",
  "version": "1.0.0",
  "label": "Papier",
  "description": "Warm paper, heavy rules, and a red accent, with photographs set apart like prints on a page. Black on warm white, or the reverse.",
  "mode": "light",
  "modes": {
    "light": {
      "ground": "#f4f1ea",
      "text": "#111111",
      "muted": "#55554f",
      "line": "#d6d2c8",
      "accent": "#d4040f"
    },
    "dark": {
      "ground": "#171613",
      "text": "#f4f1ea",
      "muted": "#aca89d",
      "line": "#37352f",
      "accent": "#ff5a4f"
    }
  },
  "contrast": [
    [
      "text",
      "ground"
    ],
    [
      "muted",
      "ground"
    ]
  ],
  "options": {
    "accent": {
      "type": "color",
      "label": "Accent colour",
      "default": {
        "light": "#d4040f",
        "dark": "#ff5a4f"
      }
    },
    "gutter": {
      "type": "select",
      "label": "Space between photos",
      "options": [
        "none",
        "hairline",
        "wide"
      ],
      "default": "wide",
      "values": {
        "none": "0px",
        "hairline": "3px",
        "wide": "1.25rem"
      }
    },
    "columns": {
      "type": "range",
      "label": "Columns on a wide screen",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  }
}
